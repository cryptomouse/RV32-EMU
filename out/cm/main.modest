
include "libc/stdlib"
include "libc/stdio"
import "bus"
import "hart/hart" as rvHart
import "hart/csr"


var hart: Hart


@nonstatic
func main (argc: Int, argv: *[]*Str8) -> Int {
	printf("RISC-V VM\n")

	if argc < 2 {
		printf("usage: %s <image.bin>\n", argv[0])
		exit(1)
	}

	let imageName: *Str8 = argv[1]
	let nbytes: Nat32 = bus.load_rom(imageName)
	if nbytes <= 0 {
		exit(1)
	}

	var busctl = BusInterface {
		read = &bus.read
		write = &bus.write
	}

	rvHart.init(&hart, 0, &busctl)

	printf(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>\n")

	var timer_cnt: Nat32 = 0

	while true {
		if not rvHart.cycle(&hart) {
			break
		}
		++timer_cnt
		if timer_cnt == 1000 {
			timer_cnt = 0
			rvHart.interrupt(&hart, rvHart.intSysTimer)
		}
	}

	printf("<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<\n")
	printf("mcycle = %u\n", rvHart.getCsr(&hart, csr.mcycleRegno))

	printf("\nCore dump:\n")
	rvHart.show_regs(&hart)
	printf("\n")
	bus.show_ram()

	return 0
}

